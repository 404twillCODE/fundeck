{
  "name": "fundeck-host-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first desktop host app for FunDeck local multiplayer",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "setup-dev": "node scripts/setup-dev.js",
    "prepare-bundle": "node scripts/prepare-bundle.js",
    "build": "npm run prepare-bundle && electron-builder --dir",
    "dist": "npm run prepare-bundle && electron-builder --win nsis portable",
    "build-all": "node scripts/build-all.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fundeck.hostdesktop",
    "productName": "FunDeck Host",
    "files": ["src/**/*", "scripts/**/*", "package.json"],
    "extraResources": [
      {
        "from": ".bundle",
        "to": "bundle",
        "filter": ["**/*"]
      }
    ],
    "directories": { "output": "dist" },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

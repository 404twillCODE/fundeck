{
  "name": "fundeck-host-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first desktop host app for FunDeck local multiplayer",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "prepare-bundle": "node scripts/prepare-bundle.js",
    "build": "npm run prepare-bundle && electron-builder --dir",
    "dist": "npm run prepare-bundle && electron-builder --win nsis portable"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "next": "16.1.6",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fundeck.hostdesktop",
    "productName": "FunDeck Host",
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "files": [
      "src/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".bundle",
        "to": "bundle",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and all subdirs: game-server, apps/host-desktop, etc.)
node_modules
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data and DBs
.data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
/game-server/game-server-data.sqlite
/game-server/game-server-data.sqlite-shm
/game-server/game-server-data.sqlite-wal

# desktop build artifacts
/apps/host-desktop/.bundle/
/apps/host-desktop/dist/
/apps/host-desktop/out/

# local temp logs
.tmp-devserver*.log

{
  "name": "fundeck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm --prefix game-server run build",
    "start": "npm --prefix game-server run start",
    "desktop:dev": "npm --prefix apps/host-desktop install && npm --prefix apps/host-desktop run dev",
    "desktop:build": "npm --prefix apps/host-desktop install && npm run build && npm --prefix apps/host-desktop run build",
    "desktop:dist": "npm --prefix apps/host-desktop install && npm run build && npm --prefix apps/host-desktop run dist",
    "lint": "eslint",
    "dev:server": "npm --prefix game-server run dev",
    "free-port": "node -e \"require('kill-port')(5250).catch(()=>{})\"",
    "predev:all": "npm run free-port",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "install:all": "npm install && npm --prefix game-server install",
    "run:all": "npm run install:all && npm run dev:all"
  },
  "dependencies": {
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socket.io-client": "^4.8.3",
    "styled-components": "^6.3.8"
  },
  "devDependencies": {
    "kill-port": "^2.0.0",
    "concurrently": "^9.1.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
